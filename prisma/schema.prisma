// ═══════════════════════════════════════════════════════════════════════════
//  ZYNETNA — database schema
//  Domains: identity · marketplace · scheduling · booking · reputation
//           monetization · platform · geo
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, pg_trgm, citext]
}

// ───────────────────────────────── IDENTITY ────────────────────────────────

enum RoleName {
  CUSTOMER
  BUSINESS_OWNER
  BUSINESS_EMPLOYEE
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Locale {
  fr
  ar
  en
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique @db.Citext
  phone         String?    @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarId      String?
  locale        Locale     @default(fr)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?  @db.Timestamptz(3)
  phoneVerified DateTime?  @db.Timestamptz(3)
  lastLoginAt   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  avatar              MediaAsset?              @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  sessions            Session[]
  roles               RoleAssignment[]
  ownedBusinesses     Business[]               @relation("BusinessOwner")
  staffProfiles       StaffMember[]
  reservations        Reservation[]            @relation("CustomerReservations")
  invitationsSent     StaffInvitation[]        @relation("InvitationsSent")
  invitationsAccepted StaffInvitation[]        @relation("InvitationsAccepted")
  reviews             Review[]
  favorites           Favorite[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  auditLogs           AuditLog[]               @relation("AuditActor")
  passwordResets      PasswordResetToken[]
  verifications       VerificationToken[]
  reportsFiled        ContentReport[]          @relation("ReportReporter")
  reviewResponses     ReviewResponse[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the opaque token. The raw token only ever exists in the cookie.
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// A user may hold several roles at once (customer AND owner AND employee elsewhere).
/// `businessId` scopes the assignment to one tenant; null for platform-wide roles.
model RoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  role       RoleName
  businessId String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, role, businessId])
  @@index([businessId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum VerificationPurpose {
  EMAIL
  PHONE
}

model VerificationToken {
  id        String              @id @default(cuid())
  tokenHash String              @unique
  userId    String
  purpose   VerificationPurpose
  expiresAt DateTime            @db.Timestamptz(3)
  usedAt    DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ──────────────────────────────────── GEO ──────────────────────────────────

model Governorate {
  id     String @id @default(cuid())
  name   String @unique
  nameAr String
  slug   String @unique
  cities City[]

  @@index([slug])
}

model City {
  id            String @id @default(cuid())
  governorateId String
  name          String
  nameAr        String
  slug          String @unique
  latitude      Float
  longitude     Float

  governorate Governorate        @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  locations   BusinessLocation[]

  @@unique([governorateId, name])
  @@index([slug])
}

// ───────────────────────────────── MARKETPLACE ─────────────────────────────

enum BusinessStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ServedGender {
  WOMEN
  MEN
  EVERYONE
}

model Business {
  id           String             @id @default(cuid())
  ownerId      String
  slug         String             @unique
  name         String
  legalName    String?
  tagline      String?
  description  String?
  story        String?
  status       BusinessStatus     @default(DRAFT)
  verification VerificationStatus @default(UNVERIFIED)
  servedGender ServedGender       @default(EVERYONE)
  currency     String             @default("TND")
  timezone     String             @default("Africa/Tunis")

  // contact
  phone     String?
  whatsapp  String?
  email     String?
  website   String?
  instagram String?
  facebook  String?
  tiktok    String?

  // booking policy (per-business, surfaced before confirmation)
  autoConfirm             Boolean @default(true)
  slotGranularityMinutes  Int     @default(15)
  minNoticeMinutes        Int     @default(120)
  maxAdvanceDays          Int     @default(60)
  cancellationWindowHours Int     @default(12)
  allowCustomerReschedule Boolean @default(true)
  allowCustomerCancel     Boolean @default(true)
  cancellationPolicy      String?
  noShowPolicy            String?
  bookingNotice           String?

  // denormalised reputation (maintained transactionally on review write)
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  publishedAt     DateTime? @db.Timestamptz(3)
  suspendedAt     DateTime? @db.Timestamptz(3)
  suspendedReason String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  owner           User                @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  location        BusinessLocation?
  categories      BusinessCategory[]
  services        Service[]
  staff           StaffMember[]
  hours           BusinessHours[]
  exceptions      ScheduleException[]
  media           BusinessMedia[]
  reservations    Reservation[]
  reviews         Review[]
  favorites       Favorite[]
  subscription    Subscription?
  roleGrants      RoleAssignment[]
  reports         ContentReport[]
  reviewResponses ReviewResponse[]
  invitations     StaffInvitation[]

  @@index([status, verification, ratingAverage])
  @@index([ownerId])
  @@index([status, publishedAt])
  @@index([slug])
}

model BusinessLocation {
  id           String  @id @default(cuid())
  businessId   String  @unique
  cityId       String?
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  latitude     Float
  longitude    Float
  /// Owner may nudge the pin; we keep the geocoded original for audit.
  geocodedLat  Float?
  geocodedLng  Float?
  directions   String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city     City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@index([latitude, longitude])
}

/// Self-referencing tree: Beauty → Hair → Coloring
model Category {
  id           String       @id @default(cuid())
  parentId     String?
  slug         String       @unique
  name         String
  nameAr       String
  nameEn       String
  description  String?
  icon         String?
  servedGender ServedGender @default(EVERYONE)
  position     Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  parent     Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]         @relation("CategoryTree")
  businesses BusinessCategory[]
  services   Service[]

  @@index([parentId, position])
  @@index([isActive, position])
}

model BusinessCategory {
  businessId String
  categoryId String
  isPrimary  Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
}

model Service {
  id                   String   @id @default(cuid())
  businessId           String
  categoryId           String?
  name                 String
  description          String?
  priceAmount          Decimal  @db.Decimal(10, 2)
  currency             String   @default("TND")
  durationMinutes      Int
  bufferMinutes        Int      @default(0)
  prepMinutes          Int      @default(0)
  /// Overrides the business default when set.
  minNoticeMinutes     Int?
  /// Overrides the business booking horizon when set — a wedding pack is
  /// booked months ahead, a beard trim a few days.
  maxAdvanceDays       Int?
  /// A pack: a bundle of this business's services sold at one price and
  /// booked as one appointment (wedding, engagement, Eid…).
  isPackage            Boolean  @default(false)
  /// Every booking stays PENDING until the business confirms it, whatever
  /// the business-wide auto-confirm setting — packs often need a word first.
  requiresConfirmation Boolean  @default(false)
  isActive             Boolean  @default(true)
  position             Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff        StaffService[]
  media        ServiceMedia[]
  items        ReservationItem[]
  /// For a pack: the services it bundles.
  packageItems ServicePackageItem[] @relation("PackageItems")
  /// For a regular service: the packs that include it.
  includedIn   ServicePackageItem[] @relation("IncludedService")

  @@index([businessId, isActive, position])
  @@index([categoryId, isActive])
}

// ──────────────────────────────────  MEDIA  ────────────────────────────────

enum MediaRole {
  LOGO
  COVER
  EXTERIOR
  INTERIOR
  PORTFOLIO
  TEAM
  GALLERY
}

/// Generic, reusable binary descriptor. Binaries live in object storage;
/// only the key + metadata are stored here.
model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  mimeType     String
  width        Int
  height       Int
  bytes        Int
  checksum     String
  blurhash     String?
  /// { thumb: key, card: key, full: key } per format
  variants     Json
  alt          String?
  uploadedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  businessMedia BusinessMedia[]
  serviceMedia  ServiceMedia[]
  reviewMedia   ReviewMedia[]
  staffAvatars  StaffMember[]
  userAvatars   User[]          @relation("UserAvatar")

  @@index([uploadedById])
  @@index([checksum])
}

model BusinessMedia {
  id         String    @id @default(cuid())
  businessId String
  assetId    String
  role       MediaRole
  position   Int       @default(0)
  caption    String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([businessId, role, position])
  @@index([assetId])
}

/// One service inside a pack. Both sides belong to the same business;
/// resolvePackItems (src/server/services/packages.ts) enforces it.
model ServicePackageItem {
  id        String @id @default(cuid())
  packageId String
  serviceId String
  position  Int    @default(0)

  package Service @relation("PackageItems", fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation("IncludedService", fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId])
}

model ServiceMedia {
  id        String @id @default(cuid())
  serviceId String
  assetId   String
  position  Int    @default(0)

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([serviceId, assetId])
  @@index([serviceId, position])
}

// ─────────────────────────────── SCHEDULING ────────────────────────────────

model StaffMember {
  id          String   @id @default(cuid())
  businessId  String
  /// Linked account when the employee logs in; null for display-only staff.
  userId      String?
  avatarId    String?
  displayName String
  title       String?
  bio         String?
  specialties String[] @default([])
  isBookable  Boolean  @default(true)
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  avatar       MediaAsset?         @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  services     StaffService[]
  hours        StaffHours[]
  exceptions   ScheduleException[]
  reservations Reservation[]
  invitations  StaffInvitation[]

  @@unique([businessId, userId])
  @@index([businessId, isActive, position])
}

/// Which professional performs which service. The booking engine honours this.
model StaffService {
  staffMemberId String
  serviceId     String

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffMemberId, serviceId])
  @@index([serviceId])
}

/// One row per working period. 09:00–13:00 and 14:00–19:00 on Monday = two rows.
/// Times are minutes from midnight in the business timezone (0..1440).
model BusinessHours {
  id         String @id @default(cuid())
  businessId String
  weekday    Int // 0 = Sunday … 6 = Saturday
  startMin   Int
  endMin     Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, weekday])
}

/// Overrides business hours for one professional when present.
model StaffHours {
  id            String @id @default(cuid())
  staffMemberId String
  weekday       Int
  startMin      Int
  endMin        Int

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, weekday])
}

enum ExceptionKind {
  CLOSED
  HOLIDAY
  VACATION
  BREAK
  SPECIAL_HOURS
}

/// Holidays, vacations, breaks, exceptional closures and exceptional openings.
/// Scoped to the whole business (staffMemberId null) or to one professional.
model ScheduleException {
  id            String        @id @default(cuid())
  businessId    String
  staffMemberId String?
  kind          ExceptionKind
  date          DateTime      @db.Date
  endDate       DateTime?     @db.Date
  /// Only for BREAK and SPECIAL_HOURS.
  startMin      Int?
  endMin        Int?
  reason        String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
  @@index([staffMemberId, date])
}

// ───────────────────────────────── BOOKING ─────────────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
  RESCHEDULED
  NO_SHOW
  EXPIRED
}

enum BookingChannel {
  ONLINE
  WALK_IN
  PHONE
}

model Reservation {
  id            String            @id @default(cuid())
  /// Human-facing code shown on the confirmation, e.g. ZY-7F3K2M.
  reference     String            @unique
  businessId    String
  customerId    String?
  staffMemberId String
  status        ReservationStatus @default(PENDING)
  channel       BookingChannel    @default(ONLINE)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// Guest details when a walk-in/phone booking has no account.
  guestName  String?
  guestPhone String?
  guestEmail String?

  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("TND")

  customerNote String?
  internalNote String?

  confirmedAt     DateTime? @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)
  cancelledAt     DateTime? @db.Timestamptz(3)
  cancelReason    String?
  /// Set on the old reservation when a reschedule creates a replacement.
  rescheduledToId String?   @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer               User?                   @relation("CustomerReservations", fields: [customerId], references: [id], onDelete: SetNull)
  staffMember            StaffMember             @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  items                  ReservationItem[]
  events                 ReservationEvent[]
  review                 Review?
  rescheduledTo          Reservation?            @relation("Reschedule", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom        Reservation?            @relation("Reschedule")
  scheduledNotifications ScheduledNotification[]

  @@index([businessId, startAt])
  @@index([staffMemberId, startAt, status])
  @@index([customerId, startAt])
  @@index([status, startAt])
  @@index([createdAt])
}

model ReservationItem {
  id              String  @id @default(cuid())
  reservationId   String
  serviceId       String
  /// Price and duration are copied at booking time: later edits to the service
  /// must never rewrite history.
  serviceName     String
  priceAmount     Decimal @db.Decimal(10, 2)
  durationMinutes Int

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([serviceId])
}

/// Append-only transition log. Never updated, never deleted.
model ReservationEvent {
  id            String             @id @default(cuid())
  reservationId String
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  actorId       String?
  actorRole     RoleName?
  reason        String?
  metadata      Json?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

// ──────────────────────────────── REPUTATION ───────────────────────────────

enum ReviewStatus {
  PUBLISHED
  PENDING_MODERATION
  HIDDEN
  REMOVED
}

model Review {
  id             String       @id @default(cuid())
  businessId     String
  customerId     String
  /// One review per completed reservation — enforced by the unique index.
  reservationId  String       @unique
  rating         Int
  comment        String?
  status         ReviewStatus @default(PUBLISHED)
  moderatedAt    DateTime?    @db.Timestamptz(3)
  moderationNote String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  response    ReviewResponse?
  media       ReviewMedia[]
  reports     ContentReport[]

  @@index([businessId, status, createdAt])
  @@index([customerId])
}

model ReviewResponse {
  id         String   @id @default(cuid())
  reviewId   String   @unique
  businessId String
  authorId   String
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ReviewMedia {
  id       String @id @default(cuid())
  reviewId String
  assetId  String
  position Int    @default(0)

  review Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  asset  MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([reviewId, assetId])
}

model Favorite {
  userId     String
  businessId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
}

enum ReportTargetType {
  BUSINESS
  REVIEW
  MEDIA
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model ContentReport {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  businessId String?
  reviewId   String?
  reporterId String?
  reason     String
  details    String?
  status     ReportStatus     @default(OPEN)
  resolvedAt DateTime?        @db.Timestamptz(3)
  resolution String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review   Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User?     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, status])
}

// ─────────────────────────────── MONETIZATION ──────────────────────────────

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  EXPIRED
  CANCELLED
}

/// Plans are DATA, not code. The launch offer (2 months free, then 30 TND/month)
/// is a row: trialDays = 60, priceAmount = 30, interval = MONTH.
model SubscriptionPlan {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  description     String?
  priceAmount     Decimal         @db.Decimal(10, 2)
  currency        String          @default("TND")
  interval        BillingInterval @default(MONTH)
  trialDays       Int             @default(0)
  gracePeriodDays Int             @default(7)
  /// Entitlement map read through src/domain/monetization/entitlements.ts
  features        Json            @default("{}")
  isActive        Boolean         @default(true)
  isDefault       Boolean         @default(false)
  position        Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  planId     String
  status     SubscriptionStatus @default(TRIALING)

  trialStartAt   DateTime? @db.Timestamptz(3)
  trialEndAt     DateTime? @db.Timestamptz(3)
  currentStartAt DateTime? @db.Timestamptz(3)
  currentEndAt   DateTime? @db.Timestamptz(3)
  graceEndAt     DateTime? @db.Timestamptz(3)
  cancelledAt    DateTime? @db.Timestamptz(3)
  cancelReason   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  events   SubscriptionEvent[]
  payments Payment[]

  @@index([status, currentEndAt])
  @@index([status, trialEndAt])
}

model SubscriptionEvent {
  id             String              @id @default(cuid())
  subscriptionId String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  actorId        String?
  metadata       Json?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("TND")
  status         PaymentStatus @default(PENDING)
  /// 'manual' at launch; a Tunisian PSP code later.
  provider       String        @default("manual")
  providerRef    String?
  periodStart    DateTime?     @db.Timestamptz(3)
  periodEnd      DateTime?     @db.Timestamptz(3)
  paidAt         DateTime?     @db.Timestamptz(3)
  failureReason  String?
  recordedById   String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

// ───────────────────────────────── PLATFORM ────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  businessId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model FeatureFlag {
  key         String   @id
  description String?
  isEnabled   Boolean  @default(false)
  /// 0..100 — percentage rollout when enabled.
  rolloutPct  Int      @default(100)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

enum NotificationType {
  RESERVATION_CREATED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_RESCHEDULED
  RESERVATION_REMINDER
  RESERVATION_COMPLETED
  REVIEW_RECEIVED
  REVIEW_RESPONSE
  BUSINESS_APPROVED
  BUSINESS_REJECTED
  BUSINESS_SUSPENDED
  TRIAL_ENDING
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_RENEWED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  metadata  Json?
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id      String              @id @default(cuid())
  userId  String
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
}

enum ScheduledNotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

/// Appointment reminders (24 h / 2 h before — configurable in platform settings).
model ScheduledNotification {
  id            String                      @id @default(cuid())
  reservationId String
  type          NotificationType
  sendAt        DateTime                    @db.Timestamptz(3)
  status        ScheduledNotificationStatus @default(PENDING)
  sentAt        DateTime?                   @db.Timestamptz(3)
  error         String?
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, type, sendAt])
  @@index([status, sendAt])
}

/// Fixed-window rate limiting, durable across instances.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  windowAt  DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

/// An invitation for someone to join a business's team with an account.
///
/// Employees are not created by typing a password on their behalf: the owner
/// invites an email, the person accepts with their own account, and only then
/// does the role assignment exist. The token is stored hashed, exactly like a
/// session or a password reset, so a leaked database row cannot be redeemed.
model StaffInvitation {
  id            String    @id @default(cuid())
  businessId    String
  /// The staff row this account will be linked to when accepted.
  staffMemberId String?
  email         String    @db.Citext
  role          RoleName  @default(BUSINESS_EMPLOYEE)
  tokenHash     String    @unique
  invitedById   String
  expiresAt     DateTime  @db.Timestamptz(3)
  acceptedAt    DateTime? @db.Timestamptz(3)
  acceptedById  String?
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  invitedBy   User         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy  User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([email])
}
