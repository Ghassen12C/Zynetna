# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Zynetna

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zynetna:zynetna_dev@127.0.0.1:5432/zynetna?schema=public

# ── Auth ────────────────────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-48-byte-random-secret-in-every-environment
SESSION_TTL_DAYS=30

# ── Storage ─────────────────────────────────────────────────────────────
# local | azure
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=/media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=zynetna-media

# ── Notifications ───────────────────────────────────────────────────────
# console | smtp   /   console | <provider>
EMAIL_DRIVER=console
EMAIL_FROM="Zynetna <no-reply@zynetna.tn>"
SMTP_URL=
SMS_DRIVER=console

# ── Payments ────────────────────────────────────────────────────────────
# manual | clictopay | paymee | flouci
PAYMENT_DRIVER=manual

# ── Maps ────────────────────────────────────────────────────────────────
# osm | azure | mapbox | google
MAP_PROVIDER=osm
MAP_API_KEY=

# ── Jobs ────────────────────────────────────────────────────────────────
JOB_TOKEN=replace-me-with-a-random-token
