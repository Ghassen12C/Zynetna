# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Zynetna

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zynetna:zynetna_dev@127.0.0.1:5432/zynetna?schema=public

# ── Auth ────────────────────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-48-byte-random-secret-in-every-environment
SESSION_TTL_DAYS=30

# ── Storage ─────────────────────────────────────────────────────────────
# local | azure
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=/media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=zynetna-media

# ── Notifications ───────────────────────────────────────────────────────
# console | resend | smtp   (production: resend, with the zynetna.tn domain verified in Resend)
EMAIL_DRIVER=console
EMAIL_FROM="Zynetna <noreply@zynetna.tn>"
RESEND_API_KEY=
SMTP_URL=
SMS_DRIVER=console

# ── Payments ────────────────────────────────────────────────────────────
# manual | clictopay | paymee | flouci
PAYMENT_DRIVER=manual

# ── Maps ────────────────────────────────────────────────────────────────
# osm | azure | mapbox | google
MAP_PROVIDER=osm
MAP_API_KEY=

# ── Jobs ────────────────────────────────────────────────────────────────
# openssl rand -hex 32 — also stored as the JOB_TOKEN secret of the
# "Scheduled jobs" GitHub workflow.
JOB_TOKEN=replace-me-with-a-random-token

# ── First production start only ─────────────────────────────────────────
# SEED_ON_START=true adds reference data (cities, categories, plans) and the
# first super admin, then can be removed together with the ADMIN_* values.
SEED_ON_START=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
